{
  "schema_version": "1.0",
  "walkthrough_id": "humanitarian-offline-field-evidence",
  "title": "Humanitarian Offline Field Evidence",
  "authority_domain": "aid-organisation",
  "action": "admit_field_evidence",
  "decision_boundary": "May this asset be used for offline needs assessment under the recorded authority and policy state?",
  "cases": [
    {
      "id": "authorized",
      "condition": "recognized actor, valid delegation, in-scope asset and action",
      "expected_outcome": "allow",
      "reason_code": "AUTHORIZED"
    },
    {
      "id": "scope-mismatch",
      "condition": "recognized actor but action or resource is outside delegation",
      "expected_outcome": "deny",
      "reason_code": "SCOPE_MISMATCH"
    },
    {
      "id": "revoked",
      "condition": "authority or delegation is revoked at decision time",
      "expected_outcome": "deny",
      "reason_code": "AUTHORITY_REVOKED"
    },
    {
      "id": "stale",
      "condition": "required authority or revocation evidence is stale or unavailable",
      "expected_outcome": "indeterminate",
      "reason_code": "TRUST_STATE_STALE"
    },
    {
      "id": "conflict",
      "condition": "authoritative sources return incompatible results",
      "expected_outcome": "review",
      "reason_code": "AUTHORITY_CONFLICT"
    },
    {
      "id": "corrected",
      "condition": "material metadata is corrected after the original decision",
      "expected_outcome": "new_decision",
      "reason_code": "SUPERSEDING_RECEIPT_REQUIRED"
    }
  ],
  "evidence_outputs": [
    "decision_receipt",
    "authority_evidence",
    "policy_epoch",
    "revocation_status",
    "replay_inputs",
    "redress_reference"
  ],
  "limitations": [
    "Does not establish factual truth",
    "Does not replace domain-professional judgment",
    "Does not transfer relying-party accountability"
  ]
}
